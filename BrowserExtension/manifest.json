{
  "manifest_version": 3,
  "name": "Haul",
  "description": "Download with Haul, the macOS download manager: captures the browser's downloads and adds Download with Haul to the menu for links.",
  "version": "1.0.0",
  "key": "",
  "browser_specific_settings": {
    "gecko": { "id": "haul@sibiraj.dev", "strict_min_version": "128.0" }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Haul",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png" }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "permissions": [
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "cookies",
    "storage",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": ["<all_urls>"]
}
