<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sparkle: the appcast attached to the latest release by scripts/release/publish.sh. -->
	<key>SUFeedURL</key>
	<string>https://github.com/sibiraj-s/haul/releases/latest/download/appcast.xml</string>
	<!-- Empty in builds without a key; Updater then links to the releases page instead. -->
	<key>SUPublicEDKey</key>
	<string>$(SPARKLE_PUBLIC_KEY)</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- Installs updates through Sparkle's XPC service, since the sandbox can't replace the app. -->
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<!-- haul://add?url=… opens the Add panel with the links filled in (IncomingLinks). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Haul download link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>haul</string>
			</array>
		</dict>
	</array>
	<!-- Shown if macOS asks before the remote downloads page is opened to the network (RemoteServer). -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Haul serves its remote downloads page to devices on your network, when you turn it on in Settings.</string>
	<!-- "Download with Haul" in the Services menu for selected links. An NSRequiredContext,
	     even an empty one, makes macOS show the service without enabling it in Settings first. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Download with Haul</string>
			</dict>
			<key>NSMessage</key>
			<string>downloadLinks</string>
			<key>NSPortName</key>
			<string>Haul</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendTypes</key>
			<array>
				<string>public.url</string>
				<string>public.utf8-plain-text</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
