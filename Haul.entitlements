<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets Haul remember folders you pick (security-scoped bookmarks) across launches. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- System services the sandbox would otherwise block. -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<!-- Sparkle's installer service, which talks to the sandboxed app. -->
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
		<!-- Lets ipconfig read the DHCP reply, where Android hotspots say they're metered. -->
		<string>com.apple.network.IPConfiguration</string>
	</array>
	<!-- The haul command: its link in ~/.local/bin, and the shell startup files that may put
	     that folder on the PATH (read to check, and the one Haul offers to add it to). -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/.local/bin/</string>
		<string>/.zshrc</string>
		<string>/.bash_profile</string>
		<string>/.config/fish/config.fish</string>
		<!-- Where browsers look for native messaging hosts, for the Chrome and Firefox
		     extension (BrowserHosts). -->
		<string>/Library/Application Support/Google/Chrome/NativeMessagingHosts/</string>
		<string>/Library/Application Support/Chromium/NativeMessagingHosts/</string>
		<string>/Library/Application Support/BraveSoftware/Brave-Browser/NativeMessagingHosts/</string>
		<string>/Library/Application Support/Microsoft Edge/NativeMessagingHosts/</string>
		<string>/Library/Application Support/Vivaldi/NativeMessagingHosts/</string>
		<string>/Library/Application Support/Arc/User Data/NativeMessagingHosts/</string>
		<string>/Library/Application Support/Mozilla/NativeMessagingHosts/</string>
	</array>
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/.zshenv</string>
		<string>/.zprofile</string>
		<string>/.zlogin</string>
		<string>/.bashrc</string>
		<string>/.profile</string>
		<string>/.config/fish/fish_variables</string>
	</array>
</dict>
</plist>
