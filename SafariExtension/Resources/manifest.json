{
  "manifest_version": 3,
  "name": "Haul",
  "description": "Download links with Haul from Safari's context menu.",
  "version": "1.0",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "permissions": ["contextMenus", "nativeMessaging"]
}
